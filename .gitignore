# Cargo build output; every crate shares the workspace's target/
target/

# pixi environments; config.toml is the one file meant for git
.pixi/*
!.pixi/config.toml

# Python bytecode caches from the basestation host tools
__pycache__/
*.py[cod]

# rustfmt backups
**/*.rs.bk

# Editor configuration
.vscode/
.zed/
.helix/
.idea/
.nvim.lua

# macOS Finder metadata
**/.DS_Store

# Local scratch files kept out of git
notforgit/
